<!DOCTYPE html>
<html>

<head>
  <title>Lisper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&family=Titan+One&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="styles/main.css">

</head>

<body>
  <h1>What's your secret?</h1>
  <% if (locals.secret && locals.user ) {%>
  <div class="card">
    <p>
      <%= secret %>
    </p>
  </div>
  <p class="user">
    <%= user %>
  </p>
  <% } else { %>
    <img src="https://i.pinimg.com/originals/3b/44/7d/3b447d5b41c31769ce50d1bd86c9d83d.gif" alt="Surprised cat">
    <p class="error">Erro Internal Servidor</p>
  <% } %>
</body>

</html>